\@writefile{toc}{\contentsline {section}{\numberline {Appendix~E}Headline subsets}{30}{appendix.E}\protected@file@percent }
\newlabel{app:subsets}{{Appendix~E}{30}{Headline subsets}{appendix.E}{}}
\newlabel{budgetlegend}{{\expandafter\protect\csname pgfplots@legend@to@name@budgetlegend\endcsname}{31}{Feature-budget sensitivity}{pgfplotslink.D.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {D.1}{\ignorespaces Feature-budget sensitivity on development data. (a) Mean development AUC of all selectors of a backbone at each budget, measured against that backbone's documented budget (logistic regression $K=20$, CatBoost $K=40$; zero by construction at those points). (b) Development AUC of the LLM-assisted family leader minus that of the classical family leader, in each dataset--backbone case; positive values favour LLM-assisted selection. Circles and solid lines are logistic regression, squares and dashed lines CatBoost. No held-out observation enters either panel.}}{31}{figure.1}\protected@file@percent }
\newlabel{fig:budgets}{{D.1}{31}{Feature-budget sensitivity on development data. (a) Mean development AUC of all selectors of a backbone at each budget, measured against that backbone's documented budget (logistic regression $\Kfeat =20$, CatBoost $\Kfeat =40$; zero by construction at those points). (b) Development AUC of the LLM-assisted family leader minus that of the classical family leader, in each dataset--backbone case; positive values favour LLM-assisted selection. Circles and solid lines are logistic regression, squares and dashed lines CatBoost. No held-out observation enters either panel}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {D.1}{\ignorespaces Development AUC of the LLM-assisted family leader minus that of the classical family leader, by feature budget; the values plotted in Figure~\ref {fig:budgets}b. Bold marks the documented budget of the backbone. Positive values favour LLM-assisted selection.}}{31}{table.1}\protected@file@percent }
\newlabel{tab:budgets}{{D.1}{31}{Development AUC of the LLM-assisted family leader minus that of the classical family leader, by feature budget; the values plotted in Figure~\ref {fig:budgets}b. Bold marks the documented budget of the backbone. Positive values favour LLM-assisted selection}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {E.1}{\ignorespaces Home Credit, ranks 1 to 20: full-DEV subsets of the two family leaders under each backbone (Table~\ref {tab:primary_results}), in selector order. The two logistic-regression subsets share 4 of 20 features; the two CatBoost subsets share 16 of 40 (continued in Table~\ref {tab:subsets_homecredit_b}).}}{31}{table.1}\protected@file@percent }
\newlabel{tab:subsets_homecredit}{{E.1}{31}{Home Credit, ranks 1 to 20: full-DEV subsets of the two family leaders under each backbone (Table~\ref {tab:primary_results}), in selector order. The two logistic-regression subsets share 4 of 20 features; the two CatBoost subsets share 16 of 40 (continued in Table~\ref {tab:subsets_homecredit_b})}{table.1}{}}
