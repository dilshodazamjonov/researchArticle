\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Primary held-out (HO) comparison. In each dataset--backbone case the LLM-assisted and the classical family leader, the selector with the highest observed HO AUC within its family, are compared on identical HO observations; both were chosen on the HO results, so the differences are descriptive and no significance is claimed. AUC is shown to four decimals; $\Delta $AUC, LLM-assisted minus classical, and its paired 95\% bootstrap interval are computed at full precision; the interval is not adjusted for the selection of the compared methods. ``Full'' is the HO AUC of an untuned full-feature model with the same fixed configuration, shown for context only. The PSI columns give the mean DEV-versus-HO population stability index of the features selected by each leader's frozen full-DEV refit (Section~\ref {subsec:metrics}); lower is less drift. Table~\ref {tab:confirmatory} repeats the comparison with leaders chosen on development data.}}{17}{table.4}\protected@file@percent }
\newlabel{tab:primary_results}{{4}{17}{Primary held-out (HO) comparison. In each dataset--backbone case the LLM-assisted and the classical family leader, the selector with the highest observed HO AUC within its family, are compared on identical HO observations; both were chosen on the HO results, so the differences are descriptive and no significance is claimed. AUC is shown to four decimals; $\Delta $AUC, LLM-assisted minus classical, and its paired 95\% bootstrap interval are computed at full precision; the interval is not adjusted for the selection of the compared methods. ``Full'' is the HO AUC of an untuned full-feature model with the same fixed configuration, shown for context only. The PSI columns give the mean DEV-versus-HO population stability index of the features selected by each leader's frozen full-DEV refit (Section~\ref {subsec:metrics}); lower is less drift. Table~\ref {tab:confirmatory} repeats the comparison with leaders chosen on development data}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Development-rule held-out (HO) comparison with leaders chosen on development data. In each dataset--backbone case the LLM-assisted and the classical family leader are the selectors with the highest mean validation AUC over the five DEV folds within their family; the two are compared once on identical HO observations. Each leader is shown with its DEV mean and, after the semicolon, its HO AUC. $\Delta $AUC, LLM-assisted minus classical, carries its paired 95\% bootstrap interval and is read against the materiality bar of $0.010$; no hypothesis test is reported (Section~\ref {subsec:inference}). The holdout plays no part in the choice of the compared methods; the rule was specified after the results of Table~\ref {tab:primary_results} were known (Section~\ref {subsec:protocol_development}). The change from the DEV mean to the HO AUC of each leader is discussed in Section~\ref {subsec:primary_results}.}}{17}{table.5}\protected@file@percent }
\newlabel{tab:confirmatory}{{5}{17}{Development-rule held-out (HO) comparison with leaders chosen on development data. In each dataset--backbone case the LLM-assisted and the classical family leader are the selectors with the highest mean validation AUC over the five DEV folds within their family; the two are compared once on identical HO observations. Each leader is shown with its DEV mean and, after the semicolon, its HO AUC. $\Delta $AUC, LLM-assisted minus classical, carries its paired 95\% bootstrap interval and is read against the materiality bar of $0.010$; no hypothesis test is reported (Section~\ref {subsec:inference}). The holdout plays no part in the choice of the compared methods; the rule was specified after the results of Table~\ref {tab:primary_results} were known (Section~\ref {subsec:protocol_development}). The change from the DEV mean to the HO AUC of each leader is discussed in Section~\ref {subsec:primary_results}}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Feature-Selection Stability}{17}{subsection.6.3}\protected@file@percent }
\newlabel{subsec:stability_results}{{6.3}{17}{Feature-Selection Stability}{subsection.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Held-out (HO) ROC-AUC of every selector of the classical and LLM-assisted families in the six dataset--backbone cases ($K=20$ for logistic regression, $K=40$ for CatBoost). Bold marks the family leader in each column, the selector with the highest observed HO AUC within its family; the last row is the LLM-assisted leader minus the classical leader, the $\Delta $AUC of Table~\ref {tab:primary_results} rounded to three decimals, which that table reports at full precision.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:full_matrix}{{6}{18}{Held-out (HO) ROC-AUC of every selector of the classical and LLM-assisted families in the six dataset--backbone cases ($\Kfeat =20$ for logistic regression, $\Kfeat =40$ for CatBoost). Bold marks the family leader in each column, the selector with the highest observed HO AUC within its family; the last row is the LLM-assisted leader minus the classical leader, the $\Delta $AUC of Table~\ref {tab:primary_results} rounded to three decimals, which that table reports at full precision}{table.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Held-out (HO) ROC-AUC of the four LLM-assisted pipelines in the six dataset--backbone cases ($K=20$ for logistic regression, $K=40$ for CatBoost). The largest value in each column is the LLM-assisted leader of Table~\ref {tab:primary_results}.}}{18}{table.7}\protected@file@percent }
\newlabel{tab:llm_pipelines}{{7}{18}{Held-out (HO) ROC-AUC of the four LLM-assisted pipelines in the six dataset--backbone cases ($\Kfeat =20$ for logistic regression, $\Kfeat =40$ for CatBoost). The largest value in each column is the LLM-assisted leader of Table~\ref {tab:primary_results}}{table.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Diversity controls on the headline comparison (Section~\ref {subsec:primary_results}). \emph  {Family cap} re-runs the HO-rule classical leader of each case with at most $\lceil K/F\rceil $ features per source family; \emph  {depth-0} restricts it to the depth-0 candidates of Stability 2024. Both are fitted on full DEV with the frozen backbones and scored once on HO. ``Uncapped'' is the classical leader's own HO AUC (Table~\ref {tab:primary_results}) and ``LLM-assisted'' its LLM-assisted counterpart in the same case; the last column is the control minus that counterpart, read against the materiality bar of $0.010$ (Section~\ref {subsec:inference}). The controls are not selectors of the comparison and appear in no family, leader or count.}}{18}{table.8}\protected@file@percent }
\newlabel{tab:diversity}{{8}{18}{Diversity controls on the headline comparison (Section~\ref {subsec:primary_results}). \emph {Family cap} re-runs the HO-rule classical leader of each case with at most $\lceil \Kfeat /F\rceil $ features per source family; \emph {depth-0} restricts it to the depth-0 candidates of Stability 2024. Both are fitted on full DEV with the frozen backbones and scored once on HO. ``Uncapped'' is the classical leader's own HO AUC (Table~\ref {tab:primary_results}) and ``LLM-assisted'' its LLM-assisted counterpart in the same case; the last column is the control minus that counterpart, read against the materiality bar of $0.010$ (Section~\ref {subsec:inference}). The controls are not selectors of the comparison and appear in no family, leader or count}{table.8}{}}
\newlabel{primlegend}{{\expandafter\protect\csname pgfplots@legend@to@name@primlegend\endcsname}{19}{Primary HO Comparison}{pgfplotslink.6.0}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Primary held-out (HO) comparison. (a) ROC-AUC of the classical family leader, the LLM-assisted family leader (the selector with the highest observed HO AUC within its family) and the untuned full-feature reference in each dataset--backbone case; the grey bar joins the two selectors being compared. (b) Paired difference, LLM-assisted minus classical, with its 95\% confidence interval; positive values favour LLM-assisted selection and the red square marks the one case in which the classical selector is higher. The intervals are paired bootstrap intervals, not adjusted for the selection of the compared methods on the same HO results; the comparison is descriptive, and Table~\ref {tab:confirmatory} gives the development-rule comparison with leaders chosen on development data.}}{19}{figure.2}\protected@file@percent }
\newlabel{fig:primary}{{2}{19}{Primary held-out (HO) comparison. (a) ROC-AUC of the classical family leader, the LLM-assisted family leader (the selector with the highest observed HO AUC within its family) and the untuned full-feature reference in each dataset--backbone case; the grey bar joins the two selectors being compared. (b) Paired difference, LLM-assisted minus classical, with its 95\% confidence interval; positive values favour LLM-assisted selection and the red square marks the one case in which the classical selector is higher. The intervals are paired bootstrap intervals, not adjusted for the selection of the compared methods on the same HO results; the comparison is descriptive, and Table~\ref {tab:confirmatory} gives the development-rule comparison with leaders chosen on development data}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces LendingClub v2 held-out comparison of Table~\ref {tab:primary_results} re-scored on sub-populations of the holdout, as row filters on the frozen HO prediction vectors with no refitting. The matured cohort is the 36-month loans issued 2016-01 to 2016-05, all of which had reached term before the 2019-05-01 snapshot, so the resolution filter of Section~\ref {subsec:dev_oot} cannot act on it; the two terms partition the holdout. $\Delta $AUC is the LLM-assisted leader minus the classical leader, read against the materiality bar of $0.010$ (Section~\ref {subsec:inference}).}}{19}{table.9}\protected@file@percent }
\newlabel{tab:lc_maturity}{{9}{19}{LendingClub v2 held-out comparison of Table~\ref {tab:primary_results} re-scored on sub-populations of the holdout, as row filters on the frozen HO prediction vectors with no refitting. The matured cohort is the 36-month loans issued 2016-01 to 2016-05, all of which had reached term before the 2019-05-01 snapshot, so the resolution filter of Section~\ref {subsec:dev_oot} cannot act on it; the two terms partition the holdout. $\Delta $AUC is the LLM-assisted leader minus the classical leader, read against the materiality bar of $0.010$ (Section~\ref {subsec:inference})}{table.9}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Effective dimension of the twelve headline subsets of Table~\ref {tab:primary_results}. ``Cat.'' is the number of the $K$ selected original variables that are categorical; ``Columns'' is the number of columns the backbone receives after the full-DEV preprocessing map of Section~\ref {subsec:preprocessing}, with an explicit missing token per categorical and levels below the minimum frequency dropped (10 observations for Home Credit and Stability 2024, 50 for LendingClub v2). Subsets with no categorical variable receive exactly $K$ columns.}}{19}{table.10}\protected@file@percent }
\newlabel{tab:dimension}{{10}{19}{Effective dimension of the twelve headline subsets of Table~\ref {tab:primary_results}. ``Cat.'' is the number of the $\Kfeat $ selected original variables that are categorical; ``Columns'' is the number of columns the backbone receives after the full-DEV preprocessing map of Section~\ref {subsec:preprocessing}, with an explicit missing token per categorical and levels below the minimum frequency dropped (10 observations for Home Credit and Stability 2024, 50 for LendingClub v2). Subsets with no categorical variable receive exactly $\Kfeat $ columns}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Best held-out (HO) secondary metric in each dataset, with the selector and backbone attaining it. KS is the maximum separation over HO thresholds; Brier is lower-is-better; Capture@10 is the share of events in the highest-scored decile, with Lift@10 in parentheses.}}{20}{table.11}\protected@file@percent }
\newlabel{tab:secondary}{{11}{20}{Best held-out (HO) secondary metric in each dataset, with the selector and backbone attaining it. KS is the maximum separation over HO thresholds; Brier is lower-is-better; Capture@10 is the share of events in the highest-scored decile, with Lift@10 in parentheses}{table.11}{}}
